# ---------------------------------------------------------------------------
# Copy to .env.local for development. Set the same keys in the Vercel
# dashboard for Preview and Production. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# MongoDB Atlas SRV string. Must include the database name.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/heavenonearth?retryWrites=true&w=majority"

# --- Auth -----------------------------------------------------------------
# At least 32 random bytes:  openssl rand -base64 48
# Rotating this immediately invalidates every outstanding admin session.
JWT_SECRET="replace-me-with-a-long-random-string"

# --- Cloudinary (server-only — API secret must never be NEXT_PUBLIC) -------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Public ---------------------------------------------------------------
# Safe to expose: the cloud name appears in every image URL anyway.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Canonical origin. Drives metadata, canonical tags, sitemap and JSON-LD.
# No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Seed script only — do NOT set these on Vercel ------------------------
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="a-long-random-passphrase"
